<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HexForm</class>
 <widget class="QMainWindow" name="HexForm">
  <property name="windowModality">
   <enum>Qt::WindowModality::NonModal</enum>
  </property>
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1280</width>
    <height>768</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string/>
  </property>
  <property name="styleSheet">
   <string notr="true">/* 全域字型與間距 */
* { font-family: &quot;Microsoft JhengHei UI&quot;,&quot;Segoe UI&quot;,&quot;Noto Sans CJK TC&quot;; font-size: 12pt; }
QMainWindow { background: #1f1f1f; }
QLabel { color: #e8e8e8; font-weight: 400; }

/* 控制列按鈕 */
QPushButton {
  background: #2b2f3a; color: #eaeaea; border: 1px solid #3a3f4b;
  border-radius: 8px; padding: 6px 14px;
}
QPushButton:hover { background: #343a46; }
QPushButton:pressed { background: #2a2f39; }

/* ComboBox */
QComboBox {
  background: #2b2f3a; color: #eaeaea; border: 1px solid #3a3f4b; border-radius: 8px; padding: 4px 10px;
}
QComboBox QAbstractItemView { background: #2b2f3a; color: #eaeaea; selection-background-color: #3b4150; }

/* 文字框 */
QPlainTextEdit {
  background: #111317; color: #dfe3ea; border: 1px solid #343a46; border-radius: 10px;
  selection-background-color: #394359;
}

/* 分隔條 */
QSplitter::handle { background: #2a2f39; width: 6px; }

QMainWindow {
    background-color: #2b2b2b;   /* 主背景 */
    color: #f0f0f0;
}

QMenuBar {
    background-color: #333;
    color: #f0f0f0;
}
QMenuBar::item::selected {
    background-color: #444;
}

QMenu {
    background-color: #555;
	color:#f0f0f0;
	selection-background-color: #444;
}

QAction {
	background-color: #555;
	color:#f0f0f0;
	selection-background-color: #444;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 6px;
    font: 11pt &quot;Arial&quot;;
}

QLineEdit {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 6px;
    font: 11pt &quot;Arial&quot;;
}

QPushButton {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #505357;
}
QPushButton:pressed {
    background-color: #2e2f30;
}

QComboBox {
    background-color: #2d2d30;
    color: #f0f0f0;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 4px;
}

QTableWidget{
	
}

QTabWidget::pane {
    border: 1px solid #3a3f4b;
    background: #1f1f1f;
}

QTabBar::tab {
    background: #2b2f3a;
    color: #eaeaea;
    padding: 6px 14px;
    border: 1px solid #3a3f4b;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #1f1f1f;
    color: #ffffff;
    border-bottom: 1px solid #1f1f1f;
}

QTabBar::tab:hover {
    background: #343a46;
}

QTabBar::close-button:hover {
    background: #ff8080;
	color: #ff5c5c;
    border-radius: 4px;
}

QStatusBar {
    background-color: #333;
    color: #f0f0f0;
}</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout">
    <item>
     <widget class="QWidget" name="hexViewWidget" native="true"/>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect>
     <x>0</x>
     <y>0</y>
     <width>1280</width>
     <height>25</height>
    </rect>
   </property>
   <widget class="QMenu" name="menuFile">
    <property name="title">
     <string>&amp;File</string>
    </property>
    <addaction name="actionNew"/>
    <addaction name="actionOpen"/>
    <addaction name="actionSave"/>
    <addaction name="actionSaveAs"/>
    <addaction name="separator"/>
    <addaction name="actionNextPage"/>
    <addaction name="actionPrevPage"/>
