  <property name="styleSheet">
   <string notr="true">/* 全域字型與間距 */
* { font-family: &quot;Microsoft JhengHei UI&quot;,&quot;Segoe UI&quot;,&quot;Noto Sans CJK TC&quot;; font-size: 12pt; }
QMainWindow { background: #1f1f1f; }
QLabel { color: #e8e8e8; font-weight: 400; }

/* 控制列按鈕 */
QPushButton {
  background: #2b2f3a; color: #eaeaea; border: 1px solid #3a3f4b;
  border-radius: 8px; padding: 6px 14px;
}
QPushButton:hover { background: #343a46; }
QPushButton:pressed { background: #2a2f39; }

/* ComboBox */
QComboBox {
  background: #2b2f3a; color: #eaeaea; border: 1px solid #3a3f4b; border-radius: 8px; padding: 4px 10px;
}
QComboBox QAbstractItemView { background: #2b2f3a; color: #eaeaea; selection-background-color: #3b4150; }

/* 文字框 */
QPlainTextEdit {
  background: #111317; color: #dfe3ea; border: 1px solid #343a46; border-radius: 10px;
  selection-background-color: #394359;
}

/* 分隔條 */
QSplitter::handle { background: #2a2f39; width: 6px; }

QMainWindow {
    background-color: #2b2b2b;   /* 主背景 */
    color: #f0f0f0;
}

QMenuBar {
    background-color: #333;
    color: #f0f0f0;
}
QMenuBar::item::selected {
    background-color: #444;
}

QMenu {
    background-color: #555;
	color:#f0f0f0;
	selection-background-color: #444;
}

QAction {
	background-color: #555;
	color:#f0f0f0;
	selection-background-color: #444;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 6px;
    font: 11pt &quot;Arial&quot;;
}

QLineEdit {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 6px;
    font: 11pt &quot;Arial&quot;;
}

QPushButton {
    background-color: #3c3f41;
    color: #ffffff;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #505357;
}
QPushButton:pressed {
    background-color: #2e2f30;
}

QComboBox {
    background-color: #2d2d30;
    color: #f0f0f0;
    border: 1px solid #555;
    border-radius: 6px;
    padding: 4px;
}

QTableWidget{
	
}</string>
