#include "../include/hexview.h"

#include <QHeaderView>
#include <QFontDatabase>
#include <QVBoxLayout>
#include <QItemSelectionModel>
#include <QUndoCommand>
#include <QShortcut>
#include <qevent.h>

static QColor highlightColorForWidget(const QWidget *w)
{
    QPalette pal = w->palette();
    QColor sel = pal.color(QPalette::Highlight);

    // 讓顏色不會超級厚重
    sel.setAlpha(160);
    return sel;
}

// === Undo Command ===

class HexEditCommand : public QUndoCommand
{
public:
    HexEditCommand(HexView *view, qint64 offset,
                   unsigned char oldByte, unsigned char newByte,
                   QUndoCommand *parent = nullptr)
        : QUndoCommand(parent),
        m_view(view),
        m_offset(offset),
        m_old(oldByte),
        m_new(newByte)
    {}

    void undo() override;
    void redo() override;

private:
    HexView       *m_view;
    qint64         m_offset;
    unsigned char  m_old;
    unsigned char  m_new;
};

void HexEditCommand::undo()
{
    if (m_view)
        m_view->setByte(m_offset, m_old, false);
}

void HexEditCommand::redo()
{
    if (m_view)
        m_view->setByte(m_offset, m_new, false);
}

// === HexView ===

HexView::HexView(QWidget *parent)
    : QWidget(parent)
{
    setFocusPolicy(Qt::StrongFocus);

    m_table = new QTableWidget(this);

    auto *layout = new QVBoxLayout(this);
    layout->setContentsMargins(0,0,0,0);
    layout->addWidget(m_table);

    setupTable();

    connect(m_table, &QTableWidget::itemChanged,
            this, &HexView::onItemChanged);
    connect(m_table->selectionModel(), &QItemSelectionModel::selectionChanged,
            this, &HexView::onSelectionChanged);
    connect(m_table, &QTableWidget::cellActivated,
            this, &HexView::onCellActivated);
    connect(m_table, &QTableWidget::cellClicked,
            this, &HexView::onMousePressEvent);

    new QShortcut(QKeySequence("Ctrl+Z"), this, [this](){ this->undo(); });
    new QShortcut(QKeySequence("Ctrl+Y"), this, [this](){ this->redo(); });

    m_table->installEventFilter(this);
    m_table->setSelectionMode(QAbstractItemView::ExtendedSelection);
    m_table->setSelectionBehavior(QAbstractItemView::SelectItems);
    m_table->setStyleSheet(R"(
        QHeaderView::section {
            background-color: #2a2a2a;   /* Header 深灰 */
            color: #e0e0e0;
            padding: 4px;
            font-weight: bold;
            border: none;
        }

        QTableWidget {
            background-color: #1e1e1e;   /* 背景深灰（不要純黑） */
            gridline-color: #3a3a3a;
            color: #e6e6e6;
            selection-background-color: #444444;
            selection-color: white;
        }
    )");
}

qint64 HexView::findBytes(const QByteArray &pattern,
                          qint64 startOffset,
                          bool backwards) {
    if (pattern.isEmpty() || m_buffer.isEmpty())
        return -1;

    qint64 bufSize = m_buffer.size();

    if (!backwards) {
        if (startOffset < 0) startOffset = 0;
        if (startOffset > bufSize) startOffset = bufSize;
        int pos = m_buffer.indexOf(pattern, int(startOffset));
        if (pos >= 0) {
            selectRange(pos, pattern.size());
            return pos;
        }
        return -1;
    } else {
        // 往前找：用 lastIndexOf
        int from = int(startOffset);
        if (from > bufSize - pattern.size())
            from = int(bufSize - pattern.size());
        if (from < 0) from = 0;

        int pos = m_buffer.lastIndexOf(pattern, from);
        if (pos >= 0) {
            selectRange(pos, pattern.size());
            return pos;
        }
        return -1;
    }
}

void HexView::selectRange(qint64 offset, int length)
{
    if (offset < 0 || length <= 0) return;
    if (offset >= m_buffer.size()) return;

    auto *sel = m_table->selectionModel();
    if (!sel) return;

    m_updating = true;
    sel->clearSelection();

    for (int i = 0; i < length; ++i) {
        qint64 off = offset + i;
        int row, colHex, colAscii;
        if (!indexFromOffset(off, row, colHex, colAscii))
            break;

        QModelIndex idxHex   = m_table->model()->index(row, colHex);
        QModelIndex idxAscii = m_table->model()->index(row, colAscii);

        sel->select(idxHex,   QItemSelectionModel::Select);
        sel->select(idxAscii, QItemSelectionModel::Select);
    }

    m_updating = false;
    refreshSelectionHighlight();
}

// === 修改 byte（供 undo/redo & 編輯使用） ===

void HexView::setByte(qint64 offset, unsigned char value, bool pushUndo)
{
    if (offset < 0) return;

    if (offset >= m_buffer.size()) {
        // 若要允許自動擴展，可改成 resize
        return;
    }

    unsigned char old = static_cast<unsigned char>(m_buffer.at(offset));
    if (old == value && pushUndo == true)
        return;

    if (pushUndo) {
        m_undo.push(new HexEditCommand(this, offset, old, value));
        return; // 真正修改會在 command.redo() 裡做
    }

    // 這裡是 undo/redo 或不記錄的修改
    m_buffer[offset] = static_cast<char>(value);

    int row, colHex, colAscii;
    if (!indexFromOffset(offset, row, colHex, colAscii))
        return;

    m_updating = true;

    if (auto *hexItem = m_table->item(row, colHex)) {
        QString hx = QString("%1").arg(value, 2, 16, QLatin1Char('0')).toUpper();
        hexItem->setText(hx);
    }

    if (auto *asciiItem = m_table->item(row, colAscii)) {
        QChar ch = (value >= 32 && value < 127) ? QChar(value) : QChar('.');
        asciiItem->setText(QString(ch));
    }

    m_updating = false;

    emit dataChangedExternally();
}

void HexView::setupTable()
{
    m_table->setColumnCount(1 + m_bytesPerRow + m_bytesPerRow); // Addr + Hex(16) + Ascii(16)

    QStringList headers;
    headers << tr("Address");
    for (int i = 0; i < m_bytesPerRow; ++i)
        headers << QString("%1").arg(i, 2, 16, QLatin1Char('0')).toUpper();
    for (int i = 0; i < m_bytesPerRow; ++i)
        headers << tr("A%1").arg(i, 2, 16, QLatin1Char('0')).toUpper(); // ASCII cols
    m_table->setHorizontalHeaderLabels(headers);

    QFont font = QFontDatabase::systemFont(QFontDatabase::FixedFont);
    m_table->setFont(font);

    // 粗略欄寬，可再調整
    m_table->setColumnWidth(0, 90);
    for (int i = 0; i < m_bytesPerRow; ++i)
        m_table->setColumnWidth(1 + i, 32);
    for (int i = 0; i < m_bytesPerRow; ++i)
        m_table->setColumnWidth(1 + m_bytesPerRow + i, 18);

    m_table->verticalHeader()->setVisible(false);
    m_table->horizontalHeader()->setSectionResizeMode(QHeaderView::Fixed);
    m_table->setShowGrid(false);
    m_table->setSelectionBehavior(QAbstractItemView::SelectItems);
    m_table->setSelectionMode(QAbstractItemView::ExtendedSelection); // 支援 Ctrl / Shift
}

void HexView::loadData(const QByteArray &data)
{
    m_buffer = data;

    m_updating = true;
    rebuildView();
    m_updating = false;

    // 根據目前 editable 狀態開關編輯
    setEditable(m_editable);
}

void HexView::rebuildView()
{
    m_table->clearContents();

    int rowCount = (m_buffer.size() + m_bytesPerRow - 1) / m_bytesPerRow;
    if (rowCount <= 0) rowCount = 1;
    m_table->setRowCount(rowCount);

    // 設定每個 cell
    for (int row = 0; row < rowCount; ++row)
    {
        const int baseOffset = row * m_bytesPerRow;

        // Address
        QString addr = QString("%1")
                           .arg(baseOffset, 8, 16, QLatin1Char('0'))
                           .toUpper();
        QTableWidgetItem *addrItem = new QTableWidgetItem(addr);
        addrItem->setFlags(addrItem->flags() & ~Qt::ItemIsEditable);
        m_table->setItem(row, 0, addrItem);

        // Hex + Ascii
        for (int i = 0; i < m_bytesPerRow; ++i)
        {
            const int colHex   = 1 + i;
            const int colAscii = 1 + m_bytesPerRow + i;
            const int index    = baseOffset + i;

            auto *hexItem   = new QTableWidgetItem;
            auto *asciiItem = new QTableWidgetItem;

            hexItem->setTextAlignment(Qt::AlignCenter);
            asciiItem->setTextAlignment(Qt::AlignCenter);

            if (index < m_buffer.size()) {
                unsigned char c = static_cast<unsigned char>(m_buffer[index]);
                QString hx = QString("%1").arg(c, 2, 16, QLatin1Char('0')).toUpper();
                hexItem->setText(hx);

                QChar ch = (c >= 32 && c < 127) ? QChar(c) : QChar('.');
                asciiItem->setText(QString(ch));
            } else {
                hexItem->setText("");
                asciiItem->setText("");
            }

            m_table->setItem(row, colHex,   hexItem);
            m_table->setItem(row, colAscii, asciiItem);
        }
    }

    refreshSelectionHighlight();
}

void HexView::setEditable(bool enabled)
{
    m_editable = enabled;
    if (!m_table) return;

    if (enabled) {
        m_table->setEditTriggers(QAbstractItemView::AllEditTriggers);
    } else {
        m_table->setEditTriggers(QAbstractItemView::NoEditTriggers);
    }
}

void HexView::gotoOffset(qint64 offset)
{
    int row, colHex, colAscii;
    if (!indexFromOffset(offset, row, colHex, colAscii))
        return;

    m_table->scrollToItem(m_table->item(row, colHex),
                          QAbstractItemView::PositionAtCenter);

    // 選取該 byte 的 hex cell
    m_table->setCurrentCell(row, colHex);
}

// === offset / index 對應 ===

qint64 HexView::offsetFromIndex(const QModelIndex &idx) const
{
    int row = idx.row();
    int col = idx.column();
    if (row < 0 || col <= 0) return -1;

    int byteIndex = -1;

    if (col >= 1 && col < 1 + m_bytesPerRow) { // Hex 區
        byteIndex = row * m_bytesPerRow + (col - 1);
    } else if (col >= 1 + m_bytesPerRow &&
               col < 1 + 2 * m_bytesPerRow) { // ASCII 區
        byteIndex = row * m_bytesPerRow + (col - 1 - m_bytesPerRow);
    }

    if (byteIndex < 0 || byteIndex >= m_buffer.size())
        return -1;

    return byteIndex;
}

bool HexView::indexFromOffset(qint64 offset, int &row, int &colHex, int &colAscii) const
{
    if (offset < 0 || offset >= m_buffer.size())
        return false;

    row      = int(offset / m_bytesPerRow);
    int pos  = int(offset % m_bytesPerRow);
    colHex   = 1 + pos;
    colAscii = 1 + m_bytesPerRow + pos;
    return true;
}

// === ASCII row 重繪（目前沒用太多，留著備用） ===

void HexView::updateAsciiRow(int row)
{
    int baseOffset = row * m_bytesPerRow;

    m_updating = true;

    for (int i = 0; i < m_bytesPerRow; ++i) {
        int idx      = baseOffset + i;
        int colAscii = 1 + m_bytesPerRow + i;

        auto *asciiItem = m_table->item(row, colAscii);
        if (!asciiItem) continue;

        if (idx < m_buffer.size()) {
            unsigned char c = static_cast<unsigned char>(m_buffer[idx]);
            QChar ch = (c >= 32 && c < 127) ? QChar(c) : QChar('.');
            asciiItem->setText(QString(ch));
        } else {
            asciiItem->setText("");
        }
    }

    m_updating = false;
}



bool HexView::eventFilter(QObject *obj, QEvent *event) {
    if (event->type() == QEvent::KeyPress) {
        auto *e = static_cast<QKeyEvent*>(event);

        // 編輯模式：QLineEdit
        if (obj->inherits("QLineEdit")) {
            if (e->key() == Qt::Key_Left || e->key() == Qt::Key_Right) {
                handleMove(e->key());
                return true;
            }
        }

        // 非編輯模式：普通格子
        if (obj == m_table) {
            if (e->key() == Qt::Key_Left || e->key() == Qt::Key_Right) {
                handleMove(e->key());
                return true;
            }
        }
    }

    return QWidget::eventFilter(obj, event);
}

// === slots ===

void HexView::onItemChanged(QTableWidgetItem *item)
{
    if (m_updating) return;
    if (!m_editable) return;
    if (!item) return;

    int row = item->row();
    int col = item->column();

    // Address 欄不編輯
    if (col == 0) return;

    qint64 offset = offsetFromIndex(m_table->model()->index(row, col));
    if (offset < 0) return;
    if (offset >= m_buffer.size()) return;

    QString text = item->text();

    // Hex 欄位：必須是 2 位 hex
    if (col >= 1 && col < 1 + m_bytesPerRow) {
        text = text.trimmed();
        if (text.size() != 2)
        {
            // 還原舊值
            unsigned char old = static_cast<unsigned char>(m_buffer[offset]);
            m_updating = true;
            item->setText(QString("%1").arg(old, 2, 16, QLatin1Char('0')).toUpper());
            m_updating = false;
            return;
        }

        bool ok = false;
        int val = text.toInt(&ok, 16);
        if (!ok || val < 0 || val > 0xFF)
        {
            unsigned char old = static_cast<unsigned char>(m_buffer[offset]);
            m_updating = true;
            item->setText(QString("%1").arg(old, 2, 16, QLatin1Char('0')).toUpper());
            m_updating = false;
            return;
        }

        setByte(offset, static_cast<unsigned char>(val), true);
    }
    // ASCII 欄位：第一個字元當作 byte
    else if (col >= 1 + m_bytesPerRow &&
             col < 1 + 2 * m_bytesPerRow)
    {
        unsigned char newVal;
        if (text.isEmpty()) {
            newVal = 0x00;
        } else {
            QChar ch = text[0];
            newVal = static_cast<unsigned char>(ch.toLatin1());
        }
        setByte(offset, newVal, true);
    }

    refreshSelectionHighlight();
}

void HexView::onSelectionChanged(const QItemSelection &,
                                 const QItemSelection &) {
    refreshSelectionHighlight();
}

void HexView::onCellActivated(int row, int column) {
    qint64 offset = offsetFromIndex(m_table->model()->index(row, column));
    if (offset >= 0)
        emit offsetActivated(offset);
}

void HexView::onMousePressEvent(int row, int col) {
    if (col == 0)
        m_table->selectRow(row);
}

void HexView::refreshSelectionHighlight()
{
    m_updating = true;

    // 先把所有背景清掉
    for (int r = 0; r < m_table->rowCount(); ++r) {
        for (int c = 1; c < m_table->columnCount(); ++c) {
            if (auto *cell = m_table->item(r, c))
                cell->setBackground(Qt::NoBrush);
        }
    }

    // 根據 selection 選出 bytes，並同步 Hex + ASCII 高亮
    const auto idxs = m_table->selectionModel()->selectedIndexes();
    for (const QModelIndex &idx : idxs) {
        qint64 off = offsetFromIndex(idx);
        if (off < 0 || off >= m_buffer.size()) continue;

        int row, colHex, colAscii;
        if (!indexFromOffset(off, row, colHex, colAscii)) continue;

        QColor hl = highlightColorForWidget(m_table);
        if (auto *h = m_table->item(row, colHex))
            h->setBackground(hl);
        if (auto *a = m_table->item(row, colAscii))
            a->setBackground(hl);
    }

    m_updating = false;
}

void HexView::handleMove(int key) {
    int row = m_table->currentRow();
    int col = m_table->currentColumn();

    bool isAscii = (col >= 17 && col <= 32);

    switch (key) {
    case Qt::Key_Right:
        if (!isAscii) {
            // HEX
            if (col < 16)
                col++;           // 下一個 HEX
            else {
                row++;
                col = 1;         // HEX 最右 → 跳到下一列 HEX
            }
        }
        else {
            // ASCII
            if (col < 32)
                col++;           // 下一個 ASCII
            else {
                row++;
                col = 17;        // ASCII 最右 → 下一行 ASCII 最左
            }
        }
        break;
    case Qt::Key_Left:
        if (isAscii) {
            if (col > 17)
                col--;           // 上一個 ASCII
            else {
                row--;
                col = 32;        // ASCII 最左 → 上一行 ASCII 最右
            }
        }
        else {
            // HEX
            if (col > 1)
                col--;           // 前一個 HEX
            else {
                row--;
                col = 16;        // HEX 最左 → 跳到上一列 HEX
            }
        }
        break;
    default:
        break;
    }

    // Clamp rows
    if (row < 0) row = 0;
    if (row >= m_table->rowCount()) row = m_table->rowCount() - 1;

    m_table->setCurrentCell(row, col);
}
