#include "../include/hexview.h"

HexView::HexView(QWidget *parent)
    : QHexEdit(parent)
{
    // 這裡做一次性外觀 / 行為設定
    setAddressArea(true);          // 顯示位址欄
    setAsciiArea(true);            // 顯示 ASCII 欄
    setDynamicBytesPerLine(true);  // 視窗大小自動調整 bytesPerLine
    setOverwriteMode(true);        // 預設覆寫模式
    setReadOnly(false);            // 可編輯
    setHexCaps(true);              // A-F 大寫或小寫看妳喜好

    // 也可以在 HexForm 那邊再覆蓋 palette 來做深色主題
}

void HexView::loadData(const QByteArray &data)
{
    // QHexEdit 已經有 setData(const QByteArray &) 的版本
    setData(data);          // property data() 對應的 setter
    setCursorPosition(0);   // 注意：這裡是 nibble 單位（2 倍 byte）
    setSelection(0);
    setSelection(1);
    ensureVisible();
}

void HexView::setEditable(bool editable)
{
    setReadOnly(!editable);
}

qint64 HexView::findBytes(const QByteArray &pattern, qint64 start, bool backwards)
{
    if (pattern.isEmpty())
        return -1;

    // QHexEdit 的 indexOf / lastIndexOf：參數是「byte offset」
    qint64 pos = backwards
                     ? lastIndexOf(pattern, start)
                     : indexOf(pattern, start);

    // 它內部已經會幫你移動游標、選取、ensureVisible
    // 我們只回傳找到的 byte offset 給 HexForm 使用
    return pos;
}

void HexView::gotoOffset(qint64 offset)
{
    const QByteArray ba = data();
    if (ba.isEmpty())
        return;

    if (offset < 0)
        offset = 0;
    if (offset >= ba.size())
        offset = ba.size() - 1;   // ⭐ 最後一個有效 byte

    qint64 nibblePos = offset * 2;
    setCursorPosition(nibblePos);

    resetSelection();
    setSelection(offset);
    setSelection(offset + 1);

    ensureVisible();
}

qint64 HexView::currentOffset() const
{
    // cursorPosition 是 nibble，所以 /2 就是 byte index
    return cursorPosition() / 2;
}

void HexView::setBaseOffset(qint64 base)
{
    // 對應 QHexEdit 的 addressOffset
    setAddressOffset(base);
}

void HexView::keyPressEvent(QKeyEvent *event)
{
    // 先讓 QHexEdit 自己處理按鍵、更新 cursorPosition()
    QHexEdit::keyPressEvent(event);

    qint64 nibblePos = cursorPosition();
    if (nibblePos < 0)
        return;

    qint64 byteIndex = nibblePos / 2;

    // ⭐ 清空舊選區（否則會亂延伸）
    resetSelection();

    // ⭐ 選取這個 byte（開始）
    setSelection(byteIndex);

    // ⭐ 選取這個 byte（結束）
    setSelection(byteIndex + 1);

    ensureVisible();
}

