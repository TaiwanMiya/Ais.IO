#ifndef HEXVIEW_H
#define HEXVIEW_H

#include <QWidget>
#include <QTableWidget>
#include <QByteArray>
#include <QUndoStack>

class HexEditCommand;

class HexView : public QWidget
{
    Q_OBJECT
public:
    // === HexView ===
    explicit HexView(QWidget *parent = nullptr);

    void loadData(const QByteArray &data);
    void setEditable(bool enabled);
    bool isEditable() const { return m_editable; }

    // 跳到指定 offset
    void gotoOffset(qint64 offset);

    // Undo / Redo 介面
    QUndoStack* undoStack() { return &m_undo; }
    void undo() { m_undo.undo(); }
    void redo() { m_undo.redo(); }

    QByteArray data() const { return m_buffer; }

    // 尋找 pattern：回傳找到的起始 offset，找不到是 -1
    qint64 findBytes(const QByteArray &pattern,
                     qint64 startOffset,
                     bool backwards = false);

    // 選取一段區間並高亮（Hex + ASCII 一起）
    void selectRange(qint64 offset, int length);

    // 真正修改某個 byte（給 undo/redo & 編輯用）
    void setByte(qint64 offset, unsigned char value, bool pushUndo = false);

    QModelIndex currentIndex() const { return m_table->currentIndex(); }
    qint64 offsetFromIndex(const QModelIndex &idx) const;

signals:
    void offsetActivated(qint64 offset);   // 點擊某 byte
    void dataChangedExternally();          // buffer 有修改時通知外部

protected:
    bool eventFilter(QObject *obj, QEvent *event) override;

private slots:
    void onItemChanged(QTableWidgetItem *item);
    void onSelectionChanged(const QItemSelection &selected,
                            const QItemSelection &deselected);
    void onCellActivated(int row, int column);
    void onMousePressEvent(int row, int col);

private:
    QTableWidget *m_table = nullptr;
    QByteArray    m_buffer;
    bool          m_editable = false;
    bool          m_updating = false;   // 防止程式改值時又觸發 onItemChanged
    int           m_bytesPerRow = 16;

    QUndoStack    m_undo;

    // 佈局 / 初始化
    void setupTable();
    void rebuildView();

    // offset / index 對應
    bool indexFromOffset(qint64 offset, int &row, int &colHex, int &colAscii) const;

    // 將某 row 的 ASCII 區重繪
    void updateAsciiRow(int row);

    // 把全部背景清掉，再依 selection 上色
    void refreshSelectionHighlight();
    void handleMove(int key);
};

#endif // HEXVIEW_H
